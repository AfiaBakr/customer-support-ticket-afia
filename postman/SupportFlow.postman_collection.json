{
  "info": {
    "name": "SupportFlow API",
    "_postman_id": "e2c7b1a0-0000-4000-8000-supportflow01",
    "description": "AI-assisted customer support ticket management. Set the collection variables `baseUrl`, then run Login to populate `token`. Ticket-scoped requests use `ticketId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Login (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set('token', b.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@supportflow.demo\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          }
        },
        {
          "name": "Login (agent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.token) pm.collectionVariables.set('token', b.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@supportflow.demo\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          }
        },
        { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" } }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.ticket && b.ticket.id) pm.collectionVariables.set('ticketId', b.ticket.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Charged twice for my order\",\n  \"description\": \"I was charged twice for the same order and need one payment refunded.\"\n}"
            }
          }
        },
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets?status=&priority=&category=&q=&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                { "key": "status", "value": "" },
                { "key": "priority", "value": "" },
                { "key": "category", "value": "" },
                { "key": "q", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        { "name": "Get ticket", "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/{{ticketId}}" } },
        {
          "name": "Assign ticket (agent self-assign)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/assign",
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Re-run AI triage (agent)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/tickets/{{ticketId}}/triage" }
        },
        {
          "name": "Update ticket (edit AI + status)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Billing\",\n  \"priority\": \"High\",\n  \"aiSummary\": \"Possible duplicate payment reported by customer.\",\n  \"aiReviewed\": true,\n  \"status\": \"In Progress\"\n}"
            }
          }
        },
        {
          "name": "Resolve ticket (agent)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolutionNote\": \"Duplicate payment confirmed and refund initiated.\"\n}"
            }
          }
        },
        {
          "name": "Reopen ticket (agent)",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/tickets/{{ticketId}}/reopen" }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "List messages",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/tickets/{{ticketId}}/messages" }
        },
        {
          "name": "Post message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello, we have reviewed your issue and are checking the duplicate payment.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Customer dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/customer" } },
        { "name": "Agent dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/agent" } },
        { "name": "Admin dashboard", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/admin" } },
        { "name": "Agent roster", "request": { "method": "GET", "url": "{{baseUrl}}/api/agents" } }
      ]
    },
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } }
  ]
}
